---
/**
 * The hero's frame: a replay of the interactive shell, played like a video. A PowerShell window on
 * Windows opens, `byo` starts the shell, and a scripted session runs by itself: typed with the
 * shell's own highlighting, completion menu and inline suggestion, answered with the CLI's own
 * strings, then looped. Nothing here takes input and nothing runs on the visitor's machine.
 */
---

<div class="node flow-cli shell" id="shell" style="--i:1">
  <div class="win-bar" aria-hidden="true">
    <svg class="win-icon" viewBox="0 0 16 16" width="16" height="16">
      <rect x="0.5" y="0.5" width="15" height="15" rx="3" fill="#3b78ff" />
      <path d="M4 5l3 3-3 3" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M8.5 11.5H12" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <span class="win-title">Your CLI</span>
    <span class="win-controls">
      <span class="win-btn"><svg viewBox="0 0 10 10"><path d="M0 5.5h10" /></svg></span>
      <span class="win-btn"><svg viewBox="0 0 10 10"><rect x="0.5" y="0.5" width="9" height="9" /></svg></span>
      <span class="win-btn"><svg viewBox="0 0 10 10"><path d="M0.5 0.5l9 9M9.5 0.5l-9 9" /></svg></span>
    </span>
  </div>
  <div class="shell-screen" id="shell-screen" aria-hidden="true">
    <div class="shell-log" id="shell-log"></div>
    <div class="shell-line shell-live" id="shell-live"></div>
    <div class="shell-menu" id="shell-menu"></div>
    <div class="shell-spacer" id="shell-spacer"></div>
  </div>
</div>

<script>
  type Kind = 'out' | 'green' | 'yellow' | 'red' | 'cyan' | 'grey' | 'blue' | 'head';
  interface Cell {
    text: string;
    grey?: boolean;
  }
  interface Line {
    text?: string;
    kind?: Kind;
    table?: { headers: string[]; rows: Cell[][] };
  }
  interface Item {
    label: string;
    desc?: string;
  }
  type Mode = 'ps' | 'byo';
  type Act =
    | { kind: 'type'; text: string }
    | { kind: 'accept' }
    | { kind: 'suggest' }
    | { kind: 'enter'; out: () => Line[]; failed?: boolean; mode?: Mode; delay?: number }
    | { kind: 'wait'; ms: number };

  const VERSION = '0.41.1';
  const HINTS = "Tab or Ctrl+Space: complete | Up/Down: history | Right: accept suggestion | Ctrl+D or 'exit': quit";
  const HOME = 'C:\\Users\\dev';
  const PS_PROMPT = `PS ${HOME}> `;
  const BYO_PROMPT_LENGTH = 'byo> '.length;

  // The command tree of a clean install, with the descriptions the CLI prints and completes with.
  const HELP: Item = { label: '--help', desc: 'Show help and usage information' };
  const COMMON: Item[] = [
    { label: '--schedule', desc: 'Repeat command on a schedule. Supports hh:mm:ss or short format like 30s, 5m, 1h, 1d, 1w, 1mo.' },
    { label: '--async', desc: 'Run command asynchronously in the background and return immediately.' },
    HELP,
  ];
  interface Group {
    desc: string;
    subs?: Record<string, string>;
    options?: Item[];
    values?: Record<string, string[]>;
  }
  const GROUPS: Record<string, Group> = {
    alias: { desc: 'Shell alias management', subs: { delete: 'Remove the shell alias for byo', set: 'Set or change the shell alias for byo' } },
    commands: { desc: 'Saved command management', subs: { delete: 'Delete a saved command', list: 'List all saved commands', set: 'Create a new saved command' } },
    plugins: { desc: 'Custom plugin management', subs: { install: 'Install BYO CLI Plugin from a local feed or NuGet.org', list: 'List available BYO CLI Plugins', uninstall: 'Uninstall BYO CLI Plugin' } },
    run: {
      desc: 'Interactive execution',
      options: [
        { label: '--target', desc: 'What to run (command or workflow)' },
        { label: '--name', desc: 'Name of the command/workflow to run' },
        { label: '--bookmark', desc: 'Bookmark hierarchy path to locate the command/workflow' },
      ],
      values: { '--target': ['command', 'workflow'] },
    },
    secrets: { desc: 'Encrypted secrets operations', subs: { delete: 'Delete a secret', list: 'Read secrets', reencrypt: 'Re-encrypt all secrets with a new key', set: 'Set a secret' } },
    settings: { desc: 'Settings operations', subs: { delete: 'Delete a setting', list: 'Read settings', set: 'Set a setting' } },
    workflows: { desc: 'Workflow management', subs: { delete: 'Delete a workflow', list: 'List all workflows', set: 'Create a new workflow with interactive steps' } },
  };
  const LEAF_OPTIONS: Record<string, Item[]> = {
    'commands set': [
      { label: '--name', desc: 'Command name' },
      { label: '--bookmark', desc: 'Bookmark hierarchy path (e.g. DevOps/Deploy)' },
      { label: '--executable', desc: 'Command executable (use {{tokenName}} for tokens resolved from configuration)' },
      { label: '--shell', desc: 'Shell type' },
      { label: '--directory', desc: 'Working directory' },
    ],
    'commands delete': [
      { label: '--name', desc: 'Command name' },
      { label: '--bookmark', desc: 'Bookmark hierarchy path (e.g. DevOps/Deploy)' },
    ],
  };
  const BUILTINS: Item[] = [
    { label: 'exit', desc: 'Exit the interactive shell' },
    { label: 'quit', desc: 'Exit the interactive shell' },
    { label: 'clear', desc: 'Clear the screen' },
    { label: 'cls', desc: 'Clear the screen' },
    { label: 'history', desc: 'Show the command history or clear it (history clear)' },
    { label: 'help', desc: 'Show help for BYO or for a command (help <command>)' },
  ];

  interface Scope {
    subs: Item[];
    options: Item[];
    values: Record<string, string[]>;
  }
  function scopeFor(path: string[]): Scope {
    if (path.length === 0) {
      return {
        subs: Object.entries(GROUPS).map(([label, g]) => ({ label, desc: g.desc })),
        options: [HELP, { label: '--version', desc: 'Show version information' }],
        values: {},
      };
    }
    const group = GROUPS[path[0]];
    if (path.length === 1) {
      if (group.subs) return { subs: Object.entries(group.subs).map(([label, desc]) => ({ label, desc })), options: [HELP], values: {} };
      return { subs: [], options: [...(group.options ?? []), ...COMMON], values: group.values ?? {} };
    }
    return { subs: [], options: [...(LEAF_OPTIONS[path.join(' ')] ?? []), ...COMMON], values: {} };
  }
  const takesValue = (label: string) => label !== '--async' && label !== '--help' && label !== '--version';

  // The shell's tokenizer and classifier, as far as the replay needs them: the same kinds, the same colours.
  interface Token {
    value: string;
    start: number;
    end: number;
    quoted: boolean;
  }
  function tokenize(text: string): Token[] {
    const tokens: Token[] = [];
    let i = 0;
    while (i < text.length) {
      if (/\s/.test(text[i])) {
        i++;
        continue;
      }
      const start = i;
      let value = '';
      let quote: string | null = null;
      let quoted = false;
      while (i < text.length) {
        const ch = text[i];
        if (quote) {
          if (ch === quote) quote = null;
          else value += ch;
          i++;
        } else if (ch === '"' || ch === "'") {
          quote = ch;
          quoted = true;
          i++;
        } else if (/\s/.test(ch)) {
          break;
        } else {
          value += ch;
          i++;
        }
      }
      tokens.push({ value, start, end: i, quoted });
    }
    return tokens;
  }

  type TokenKind = 'tool' | 'builtin' | 'command' | 'option' | 'value' | 'quoted' | 'unknown';
  interface Walk {
    path: string[];
    pending: string | null;
    words: number;
  }
  function step(state: Walk, token: Token, index: number): TokenKind {
    if (index === 0 && token.value.toLowerCase() === 'byo') return 'tool';
    const first = state.words === 0;
    state.words++;
    if (state.pending) {
      state.pending = null;
      return token.quoted ? 'quoted' : 'value';
    }
    const scope = scopeFor(state.path);
    if (token.value.length > 1 && token.value[0] === '-') {
      const option = scope.options.find((o) => o.label === token.value);
      if (!option) return 'unknown';
      state.pending = takesValue(option.label) ? option.label : null;
      return 'option';
    }
    if (scope.subs.some((s) => s.label === token.value)) {
      state.path.push(token.value);
      return 'command';
    }
    if (first && BUILTINS.some((b) => b.label === token.value)) return 'builtin';
    return 'unknown';
  }

  // The completion menu opens on its own as a word is typed and closes once the word is complete.
  interface Completion {
    start: number;
    items: Item[];
  }
  function completions(text: string): Completion | null {
    const tokens = tokenize(text);
    const open = tokens.length > 0 && !/\s$/.test(text);
    const current = open ? tokens[tokens.length - 1] : null;
    if (current?.quoted) return null;
    const before = open ? tokens.slice(0, -1) : tokens;
    const state: Walk = { path: [], pending: null, words: 0 };
    before.forEach((t, i) => step(state, t, i));
    const word = current?.value ?? '';
    const scope = scopeFor(state.path);
    let items: Item[];
    if (state.pending) {
      const values = scope.values[state.pending];
      if (!values) return null;
      items = values.map((label) => ({ label }));
    } else if (word.startsWith('-')) {
      items = scope.options;
    } else if (state.words === 0) {
      items = [...scope.subs, ...BUILTINS];
    } else {
      items = scope.subs;
    }
    items = items.filter((i) => i.label.startsWith(word));
    if (items.length === 0 || word.length === 0 || (items.length === 1 && items[0].label === word)) return null;
    return { start: current ? current.start : text.length, items };
  }

  // Output, in the CLI's words.
  const out = (text: string, kind: Kind = 'out'): Line => ({ text, kind });
  const blank = (): Line => ({ text: '' });
  const between = (a: number, b: number) => a + Math.floor(Math.random() * (b - a + 1));
  const pad = (s: string, w: number) => s + ' '.repeat(Math.max(0, w - s.length));
  const stamp = () => {
    const d = new Date();
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  };

  function rootHelp(): Line[] {
    const names = Object.keys(GROUPS);
    const width = Math.max(...names.map((n) => n.length)) + 2;
    return [
      'Description:',
      '',
      'Usage:',
      '  byo [command] [options]',
      '',
      'Options:',
      '  -?, -h, --help  Show help and usage information',
      '  --version       Show version information',
      '',
      'Commands:',
      ...names.map((n) => '  ' + pad(n, width) + GROUPS[n].desc),
    ].map((text) => out(text));
  }

  const banner = (): Line[] => [out(`BYO interactive shell ${VERSION}`, 'cyan'), out(HINTS, 'grey'), blank()];
  const completed = (from: number, to: number): Line[] => [blank(), out(`Completed in ${between(from, to)} ms.`, 'green')];

  let createdAt = stamp();
  const list = (): Line[] => [
    out('Demo', 'head'),
    {
      table: {
        headers: ['Name', 'Bookmark', 'Executable', 'Directory', 'Created'],
        rows: [[{ text: 'Say hello' }, { text: 'Demo' }, { text: 'echo Hello from byo' }, { text: '-', grey: true }, { text: createdAt }]],
      },
    },
    blank(),
    ...completed(5, 14),
  ];

  const SCRIPT: Act[] = [
    { kind: 'type', text: 'byo' },
    { kind: 'enter', out: banner, mode: 'byo', delay: 480 },
    { kind: 'type', text: 'commands set --name "Say hello" --bookmark Demo --executable "echo Hello from byo"' },
    { kind: 'enter', out: () => [out('Command added successfully!', 'green'), ...completed(3, 9)] },
    { kind: 'type', text: 'commands list' },
    { kind: 'enter', out: list },
    { kind: 'type', text: 'run --t' },
    { kind: 'accept' },
    { kind: 'type', text: 'command --name "Say hello" --bookmark Demo' },
    {
      kind: 'enter',
      delay: 320,
      out: () => [out('Command: echo Hello from byo', 'blue'), out(`Directory: ${HOME}`, 'blue'), out('Hello from byo'), ...completed(84, 140)],
    },
    { kind: 'type', text: 'comands list' },
    {
      kind: 'enter',
      failed: true,
      out: () => [
        out('Required command was not provided.', 'red'),
        out("Unrecognized command or argument 'comands'.", 'red'),
        out("Unrecognized command or argument 'list'.", 'red'),
        blank(),
        ...rootHelp(),
      ],
    },
    { kind: 'type', text: 'comm' },
    { kind: 'suggest' },
    { kind: 'enter', out: list },
    { kind: 'type', text: 'exit' },
    { kind: 'enter', out: () => [], mode: 'ps' },
    { kind: 'wait', ms: 2600 },
  ];

  const root = document.getElementById('shell');
  const view = document.getElementById('shell-screen');
  const log = document.getElementById('shell-log');
  const live = document.getElementById('shell-live');
  const menu = document.getElementById('shell-menu');
  const spacer = document.getElementById('shell-spacer');
  if (root && view && log && live && menu && spacer) {
    const instant = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let mode: Mode = 'ps';
    let text = '';
    let failed = false;
    let history: string[] = [];
    let current: Completion | null = null;
    let floor = 0;
    let spacerHeight = 0;

    // Playback pauses while the frame is off screen or the tab is hidden, and resumes where it was.
    let paused = false;
    let resume: (() => void) | null = null;
    const sleep = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));
    async function wait(ms: number) {
      if (instant) return;
      if (ms > 0) await sleep(ms);
      while (paused) await new Promise<void>((r) => (resume = r));
    }
    let visible = true;
    function updatePaused() {
      paused = !visible || document.hidden;
      if (!paused && resume) {
        const r = resume;
        resume = null;
        r();
      }
    }
    new IntersectionObserver(
      (entries) => {
        visible = entries.some((e) => e.isIntersecting);
        updatePaused();
      },
      { threshold: 0.1 },
    ).observe(root);
    document.addEventListener('visibilitychange', updatePaused);

    const span = (className: string, content: string) => {
      const el = document.createElement('span');
      el.className = className;
      el.textContent = content;
      return el;
    };

    // A terminal only scrolls forward. When content shrinks (a menu closes), the rows it used stay
    // blank below the prompt until output fills them, so the screen never jumps back.
    function settle() {
      const natural = view!.scrollHeight - spacerHeight;
      spacerHeight = Math.max(0, floor + view!.clientHeight - natural);
      spacer!.style.height = `${spacerHeight}px`;
      view!.scrollTop = view!.scrollHeight;
      floor = Math.max(floor, view!.scrollTop);
    }

    function renderInput(target: HTMLElement, withCursor: boolean) {
      target.textContent = '';
      let ghost = '';
      if (mode === 'ps') {
        target.append(span('t-ps', PS_PROMPT));
        const m = text.match(/^(\s*)(\S+)([\s\S]*)$/);
        if (m) target.append(m[1], span('t-ps-cmd', m[2]), m[3]);
        else target.append(text);
      } else {
        const prompt = span('t-prompt', 'byo');
        prompt.append(span('t-gt' + (failed ? ' is-failed' : ''), '>'));
        target.append(prompt, ' ');
        const state: Walk = { path: [], pending: null, words: 0 };
        let at = 0;
        tokenize(text).forEach((token, i) => {
          const kind = step(state, token, i);
          if (token.start > at) target.append(text.slice(at, token.start));
          target.append(span(`t-${kind}`, text.slice(token.start, token.end)));
          at = token.end;
        });
        if (at < text.length) target.append(text.slice(at));
        if (withCursor) ghost = suggestion(text);
      }
      if (withCursor) {
        // The caret sits on the first character of the inline suggestion, as in the shell.
        target.append(span('shell-cursor' + (ghost ? ' t-ghost' : ''), ghost ? ghost[0] : '\u00a0'));
        if (ghost.length > 1) target.append(span('t-ghost', ghost.slice(1)));
      }
    }

    function suggestion(value: string): string {
      if (!value) return '';
      for (let i = history.length - 1; i >= 0; i--) {
        if (history[i].startsWith(value) && history[i] !== value) return history[i].slice(value.length);
      }
      return '';
    }

    function columns(): number {
      const probe = span('shell-probe', 'M'.repeat(20));
      view!.append(probe);
      const ch = probe.getBoundingClientRect().width / 20;
      probe.remove();
      const style = getComputedStyle(view!);
      const inner = view!.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      return Math.max(20, Math.floor(inner / Math.max(1, ch)));
    }

    const fit = (s: string, width: number) => (width <= 0 ? '' : s.length <= width ? pad(s, width) : width <= 3 ? s.slice(0, width) : s.slice(0, width - 3) + '...');

    // The shell's menu, drawn its way: label and description columns, the selected row black on cyan,
    // placed under the word being completed.
    function renderMenu() {
      menu!.textContent = '';
      current = mode === 'byo' ? completions(text) : null;
      if (!current) return;
      const items = current.items;
      const cols = columns();
      const maxRowWidth = cols - 1;
      let labelWidth = Math.min(Math.max(...items.map((i) => i.label.length)), Math.max(10, Math.floor(maxRowWidth / 2)));
      let descWidth = Math.min(Math.max(...items.map((i) => i.desc?.length ?? 0)), 60);
      descWidth = Math.max(0, Math.min(descWidth, maxRowWidth - labelWidth - 5));
      let rowWidth = labelWidth + 2 + (descWidth > 0 ? descWidth + 2 : 0);
      if (rowWidth > maxRowWidth) {
        labelWidth = Math.max(1, maxRowWidth - 2);
        descWidth = 0;
        rowWidth = labelWidth + 2;
      }
      const column = Math.min((BYO_PROMPT_LENGTH + current.start) % cols, Math.max(0, maxRowWidth - rowWidth));
      const visibleCount = Math.min(8, items.length);
      const row = (className: string) => {
        const el = document.createElement('div');
        el.className = 'menu-row ' + className;
        el.style.marginLeft = `${column}ch`;
        menu!.append(el);
        return el;
      };
      for (let i = 0; i < visibleCount; i++) {
        const el = row(i === 0 ? 'is-selected' : '');
        el.append(' ' + fit(items[i].label, labelWidth) + ' ');
        if (descWidth > 0) el.append(span('menu-desc', fit(items[i].desc ?? '', descWidth) + '  '));
      }
      const selected = items[0].desc ?? '';
      if (selected.length > descWidth && maxRowWidth - column > 10) {
        row('menu-more').textContent = ' ' + fit(selected, maxRowWidth - column - 1).trimEnd();
      }
      if (items.length > visibleCount) row('menu-more').textContent = ` 1/${items.length}`;
    }

    function lineElement(line: Line): HTMLElement {
      const el = document.createElement('div');
      el.className = 'shell-line' + (line.kind && line.kind !== 'out' ? ` k-${line.kind}` : '');
      if (line.table) {
        el.classList.add('k-table');
        const table = document.createElement('table');
        table.className = 'shell-table';
        const head = table.createTHead().insertRow();
        for (const h of line.table.headers) {
          const th = document.createElement('th');
          th.textContent = h;
          head.append(th);
        }
        const body = table.createTBody();
        for (const r of line.table.rows) {
          const tr = body.insertRow();
          for (const cell of r) {
            const td = tr.insertCell();
            td.textContent = cell.text;
            if (cell.grey) td.className = 'k-grey';
          }
        }
        el.append(table);
      } else {
        el.textContent = line.text || ' ';
      }
      return el;
    }

    async function print(lines: Line[]) {
      const stagger = Math.min(36, 420 / Math.max(1, lines.length));
      for (const line of lines) {
        log!.append(lineElement(line));
        settle();
        await wait(stagger);
      }
      while (log!.childElementCount > 400) log!.firstChild!.remove();
    }

    function show() {
      renderInput(live!, true);
      renderMenu();
      settle();
    }

    async function perform(act: Act) {
      switch (act.kind) {
        case 'type': {
          root!.classList.add('is-typing');
          await wait(140);
          for (const ch of act.text) {
            text += ch;
            show();
            await wait(between(28, 70) + (ch === ' ' ? 40 : 0));
          }
          root!.classList.remove('is-typing');
          return;
        }
        case 'accept': {
          if (!current) return;
          await wait(520);
          text = text.slice(0, current.start) + current.items[0].label + ' ';
          menu!.textContent = '';
          current = null;
          renderInput(live!, true);
          settle();
          await wait(160);
          return;
        }
        case 'suggest': {
          const rest = suggestion(text);
          await wait(650);
          text += rest;
          show();
          await wait(260);
          return;
        }
        case 'enter': {
          await wait(380);
          menu!.textContent = '';
          current = null;
          const frozen = document.createElement('div');
          frozen.className = 'shell-line';
          renderInput(frozen, false);
          log!.append(frozen);
          if (mode === 'byo' && text.trim()) {
            const entry = text.trim();
            history = history.filter((h) => h !== entry);
            history.push(entry);
          }
          live!.hidden = true;
          settle();
          await wait(act.delay ?? 220);
          await print(act.out());
          failed = act.failed ?? false;
          if (act.mode) mode = act.mode;
          text = '';
          live!.hidden = false;
          show();
          await wait(1000);
          return;
        }
        case 'wait':
          await wait(act.ms);
      }
    }

    function reset() {
      log!.textContent = '';
      menu!.textContent = '';
      spacerHeight = 0;
      spacer!.style.height = '0px';
      floor = 0;
      history = [];
      failed = false;
      mode = 'ps';
      text = '';
      createdAt = stamp();
      live!.hidden = false;
      show();
    }

    async function play() {
      for (;;) {
        reset();
        for (const act of SCRIPT) await perform(act);
        if (instant) return;
      }
    }

    void play();
  }
</script>
