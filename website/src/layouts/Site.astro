---
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const repo = 'https://github.com/softwareworkercom/byo';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/byo-icon.png')} />
    <link rel="apple-touch-icon" href={withBase('/byo-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/byo-logo.png'), Astro.site)} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={withBase('/')} aria-label="BYO CLI home">
          <img src={withBase('/byo-icon.png')} alt="" width="28" height="28" />
          <span>BYO CLI</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li><a href={withBase('/docs/')}>Docs</a></li>
            <li class="hide-mobile"><a href={withBase('/docs/building-a-plugin/')}>Build a plugin</a></li>
            <li><a href={repo}>GitHub</a></li>
            <li><a class="btn btn-small" href={withBase('/#install')}>Install</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <ul>
          <li><a href={repo}>GitHub</a></li>
          <li><a href={`${repo}/issues`}>Issues</a></li>
          <li><a href={`${repo}/discussions`}>Discussions</a></li>
          <li><a href={`${repo}/releases/latest`}>Latest release</a></li>
          <li><a href="https://www.nuget.org/packages/BYO.SDK">BYO.SDK on NuGet</a></li>
          <li><a href={`${repo}/blob/main/LICENSE`}>MIT license</a></li>
        </ul>
        <p>Copyright © {year} Software Worker. BYO CLI is open source, pre-1.0 software. Everything it saves stays on your machine.</p>
      </div>
    </footer>
  </body>
</html>
