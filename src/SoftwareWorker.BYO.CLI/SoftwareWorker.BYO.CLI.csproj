<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>byo</AssemblyName>
		<PackageId>byo</PackageId>
		<!-- Keep reflection-based System.Text.Json working in trimmed/self-contained publish builds -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<!-- This makes it a .NET tool -->
		<PackAsTool>true</PackAsTool>
		<!-- The command users will run -->
		<ToolCommandName>byo</ToolCommandName>
		<PackageIcon>Icons/byo-icon.png</PackageIcon>

		<!-- NuGet Package Metadata -->
		<Title>BYO CLI</Title>
		<Description>A powerful and flexible CLI tool for developer productivity.</Description>
		<Authors>Leandro Monaco</Authors>
		<Company>Software Worker</Company>
       <PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://www.byocli.com</PackageProjectUrl>
		<RepositoryUrl>https://github.com/softwareworkercom/byo</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>cli;productivity;software-worker;developer;devex;devops</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	<_Parameter1>ToolCommandName</_Parameter1>
	<_Parameter2>$(ToolCommandName)</_Parameter2>
	</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
     <PackageReference Include="Nerdbank.GitVersioning">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
       <PackageReference Include="Spectre.Console" />
	</ItemGroup>

	<!-- Always build against the current SDK sources so CI/local builds resolve the same code. -->
	<ItemGroup>
		<ProjectReference Include="..\SoftwareWorker.BYO.SDK\SoftwareWorker.BYO.SDK.csproj" />
	</ItemGroup>

		<ItemGroup>
			<None Update="version.json">
				<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			</None>
		</ItemGroup>

		<ItemGroup>
			<None Include="../../docs/Images/byo-icon.png" Pack="true" PackagePath="Icons/" />
		</ItemGroup>

	</Project>
