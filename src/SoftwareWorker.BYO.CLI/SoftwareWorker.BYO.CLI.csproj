<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>byo</PackageId>
		<!-- This makes it a .NET tool -->
		<PackAsTool>true</PackAsTool>
		<!-- The command users will run -->
		<ToolCommandName>byo</ToolCommandName>
		<PackageIcon>Icons\byo-logo.png</PackageIcon>

		<!-- NuGet Package Metadata -->
		<Title>BYO CLI</Title>
		<Description>A powerful and flexible CLI tool for developer productivity.</Description>
		<Authors>Leandro Monaco</Authors>
		<Company>Software Worker</Company>
		<PackageReadmeFile>README.md</PackageReadmeFile>
       <PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://byocli.com</PackageProjectUrl>
		<RepositoryUrl>https://github.com/softwareworkercom/byo</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>cli;productivity;software-worker;developer;devex;devops</PackageTags>
	</PropertyGroup>

 <ItemGroup>
		<None Include="Icons\byo-logo.png" Pack="true" PackagePath="Icons\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
	</ItemGroup>

	<ItemGroup>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	<_Parameter1>ToolCommandName</_Parameter1>
	<_Parameter2>$(ToolCommandName)</_Parameter2>
	</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.10.8-alpha" />
		<PackageReference Include="Spectre.Console" Version="0.55.0" />
	</ItemGroup>

		<ItemGroup>
			<ProjectReference Include="..\SoftwareWorker.BYO.Core\SoftwareWorker.BYO.Core.csproj" />
			<None Update="version.json">
				<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			</None>
		</ItemGroup>

	</Project>
